# Обогащение описаний и рекомендации: deepseek-flash через DeepSeek API.
DEEPSEEK_API_KEY=ваш_ключ_DeepSeek

# Обязателен для эмбеддингов NVIDIA Nemotron 3 Embed 1B (2048 чисел).
# При включении реранкинга используется и для него.
OPENROUTER_API_KEY=ваш_ключ_OpenRouter

# Для разработки и будущих экспериментов: false отключает реранкинг для сравнения.
RERANK_ENABLED=true
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# Для локального Python-запуска. Docker Compose сам задаёт QDRANT_HOST=qdrant.
QDRANT_HOST=localhost
QDRANT_PORT=6333
